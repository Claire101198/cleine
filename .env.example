# Copy this file to .env and fill in real values, then restart the dev server.
# The contact form does NOT send anywhere until one of these is configured
# (see src/components/ContactForm.tsx for the integration point).

# Option A: Formspree (https://formspree.io) — simplest, no backend needed.
# Create a form there and paste its endpoint below.
VITE_FORMSPREE_ENDPOINT=

# Option B: EmailJS (https://www.emailjs.com)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Option C: a custom backend / Resend-based API route.
VITE_CONTACT_API_URL=
